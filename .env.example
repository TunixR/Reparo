# Framework settings, read by settings.py. Copy to .env and fill in.
# Docker service credentials live in docker/.env (see docker/README.md).

# Postgres: must match the database in docker/.env
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# LLM provider routers, seeded by populate.py (database/populators/routers.json, see README.md
# "LLM providers"). PROVIDER, PROVIDER_API_BASE and PROVIDER_API_KEY apply to every router role.
PROVIDER=openrouter  # openrouter, openai or vllm (any OpenAI-compatible endpoint)
PROVIDER_API_BASE=https://openrouter.ai/api/v1
PROVIDER_API_KEY=your_api_key
# Optional key for the vision and vision_tool roles (free-tier models); empty uses PROVIDER_API_KEY
FREE_PROVIDER_API_KEY=
PROVIDER_MODEL="qwen/qwen3-235b-a22b-2507"  # text role: gateway and error agents
PROVIDER_GROUNDING_MODEL="qwen/qwen3.5-35b-a3b"  # grounding role: the GUI agent (needs vision)
PROVIDER_GROUNDING_MODEL_BACKBONE="QWEN3.5"  # OTHER, QWEN2.5 or QWEN3.5: the model's click coordinate space
# Vision roles, not used by the default agents. Free models rotate: check openrouter.ai/models
PROVIDER_VISION_MODEL="google/gemma-4-31b-it:free"
PROVIDER_VISION_TOOL_MODEL="google/gemma-4-31b-it:free"
# Per-role overrides (ROLE = TEXT, GROUNDING, UITARS, VISION, VISION_TOOL); empty = the defaults above
# ROUTER_GROUNDING_PROVIDER=vllm
# ROUTER_GROUNDING_API_BASE=http://localhost:8001/v1
# ROUTER_GROUNDING_API_KEY=
OLLAMA_URL=http://localhost:11434  # read by settings.py but not used yet

# GUI agents
MAX_GUI_IMAGES="5"
# A GUI agent's conversation holds at most MAX_GUI_IMAGES + MAX_GUI_IMAGES_PRUNE_CHUNK screenshots
# (keep both under any per-request image limit of the provider). Past that, it is cut back to the
# newest MAX_GUI_IMAGES in one batch, so the provider's prompt cache survives between prunes.
# 0 prunes every step.
MAX_GUI_IMAGES_PRUNE_CHUNK="10"

# S3-compatible storage for screenshots: must match S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY in docker/.env.
# populate.py creates the bucket.
S3_URL="http://localhost:8333"
S3_BUCKET=reparo
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Auth: JWT signing for user sessions
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM="HS256"

# Admin seed: administrator created or updated by populate.py
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Observability: OTLP export to the SigNoz collector from docker/compose.dev.yaml (see OBSERVABILITY.md)
OBSERVABILITY_ENABLED="true"
OTEL_SERVICE_NAME="reparo-api"
OTEL_SERVICE_NAMESPACE="reparo"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_TRACES_SAMPLER_ARG="1.0"
DEPLOYMENT_ENVIRONMENT="development"
LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_FILE=""
LOG_FILE_MAX_BYTES="10000000"
LOG_FILE_BACKUP_COUNT="5"
STRANDS_LOG_LEVEL="INFO"
OTEL_SEMCONV_STABILITY_OPT_IN="gen_ai_latest_experimental,gen_ai_span_attributes_only"
TELEMETRY_MAX_TEXT_LENGTH="120"

# Integration tests only (not used by the app)
POSTGRES_MONITOR_USER=otel_monitor  # tests/integration/postgres: must match docker/.env
# SigNoz access for tests/integration/observability
SIGNOZ_CLICKHOUSE_URL=""
SIGNOZ_CLICKHOUSE_CONTAINER="reparo-signoz-clickhouse-1"
SIGNOZ_POLL_TIMEOUT="60"
