{
  "path": ["."],
  "format": ["python"],
  "ignore": ["**/.venv/**", "**/migrations/**", "**/tests/**"],
  "ignorePattern": [
    "(?m)^(?:from|import) [^(\\n]*$",
    "(?ms)^from [\\w.]+ import \\(.*?^\\)"
  ],
  "similarity": 0.8,
  "baseline": ".jscpd-baseline.json",
  "failOnNewClones": 0,
  "failOnEmpty": true
}
